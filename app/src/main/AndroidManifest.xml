<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for a user-initiated antivirus-style audit of installed packages. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <!-- Special access: user must grant manually in Android Settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <application
        android:label="ASTER Guard"
        android:icon="@drawable/ic_shield"
        android:theme="@style/Theme.AsterGuard"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
